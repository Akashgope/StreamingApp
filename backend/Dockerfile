FROM node:18-alpine
WORKDIR /app
ARG SERVICE_NAME
ENV SERVICE_NAME=$SERVICE_NAME
COPY ./common ./common
COPY ./$SERVICE_NAME/package*.json ./$SERVICE_NAME/
RUN cd $SERVICE_NAME && npm ci
COPY ./$SERVICE_NAME ./$SERVICE_NAME
WORKDIR /app/$SERVICE_NAME
EXPOSE 3001 3002 3003 3004
CMD ["sh", "-c", "npm start"]

